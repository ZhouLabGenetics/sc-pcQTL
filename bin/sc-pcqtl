#!/usr/bin/env bash
set -euo pipefail

launcher_version='0.1.0-dev'
pipeline=${SCPCQTL_PIPELINE:-ZhouLabGenetics/sc-pcQTL}
revision=${SCPCQTL_REVISION:-main}
nextflow_bin=${SCPCQTL_NEXTFLOW:-nextflow}

usage() {
  cat <<'EOF'
sc-pcqtl: portable launcher for the sc-pcQTL Nextflow workflow

Usage:
  sc-pcqtl doctor [--deep]
  sc-pcqtl example [Nextflow options]
  sc-pcqtl run [pipeline parameters]
  sc-pcqtl nextflow [Nextflow arguments]
  sc-pcqtl version

Environment overrides:
  SCPCQTL_RUNTIME   docker, podman, apptainer, or singularity
  SCPCQTL_PIPELINE  Nextflow project name or local project directory
  SCPCQTL_REVISION  Git branch or release tag (default: main)
  SCPCQTL_NEXTFLOW  Nextflow executable
  SCPCQTL_EXTRA_PROFILES  Additional profiles, for example slurm or sge
  SCPCQTL_SMOKE_IMAGE  Small image used by doctor --deep
EOF
}

die() {
  printf 'sc-pcqtl: %s\n' "$*" >&2
  exit 1
}

has_command() {
  command -v "$1" >/dev/null 2>&1
}

runtime_command() {
  case "$1" in
    docker) printf '%s\n' docker ;;
    podman) printf '%s\n' podman ;;
    apptainer) printf '%s\n' apptainer ;;
    singularity) printf '%s\n' singularity ;;
    *) return 1 ;;
  esac
}

runtime_ready() {
  case "$1" in
    docker) docker info >/dev/null 2>&1 ;;
    podman) podman info >/dev/null 2>&1 ;;
    apptainer) apptainer --version >/dev/null 2>&1 ;;
    singularity) singularity --version >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

select_runtime() {
  local requested=${SCPCQTL_RUNTIME:-}
  local candidate candidates
  if [[ -n "$requested" ]]; then
    runtime_command "$requested" >/dev/null || \
      die "SCPCQTL_RUNTIME must be docker, podman, apptainer, or singularity"
    has_command "$(runtime_command "$requested")" || \
      die "requested runtime '$requested' is not available in PATH"
    runtime_ready "$requested" || \
      die "requested runtime '$requested' is installed but not ready"
    printf '%s\n' "$requested"
    return
  fi

  case "$(uname -s):$(uname -m)" in
    Darwin:*) candidates='docker podman' ;;
    Linux:aarch64|Linux:arm64) candidates='docker podman' ;;
    Linux:*) candidates='apptainer singularity docker podman' ;;
    *) candidates='docker podman apptainer singularity' ;;
  esac
  for candidate in $candidates; do
    if has_command "$(runtime_command "$candidate")" && runtime_ready "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  die 'no ready container runtime found; run sc-pcqtl doctor for guidance'
}

check_java() {
  local line version major
  if ! has_command java; then
    printf '[missing] Java 17 or newer\n'
    return 1
  fi
  line=$(java -version 2>&1 | head -n 1)
  version=$(printf '%s\n' "$line" | sed -E 's/.*version "([^"]+)".*/\1/')
  major=${version%%.*}
  if [[ "$major" == '1' ]]; then
    version=${version#1.}
    major=${version%%.*}
  fi
  if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 17 )); then
    printf '[ok] Java %s\n' "$version"
    return 0
  fi
  printf '[incompatible] Java %s; version 17 or newer is required\n' "$version"
  return 1
}

check_nextflow() {
  local output version major minor
  if ! command -v "$nextflow_bin" >/dev/null 2>&1; then
    printf '[missing] Nextflow executable: %s\n' "$nextflow_bin"
    return 1
  fi
  if ! output=$("$nextflow_bin" -version 2>&1); then
    printf '[failed] Nextflow could not start: %s\n' "$nextflow_bin"
    return 1
  fi
  if [[ "$output" =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
    version=${BASH_REMATCH[1]}
    major=${version%%.*}
    minor=${version#*.}
    minor=${minor%%.*}
    if (( major > 25 || (major == 25 && minor >= 10) )); then
      printf '[ok] Nextflow %s\n' "$version"
      return 0
    fi
    printf '[incompatible] Nextflow %s; version 25.10.0 or newer is required\n' "$version"
    return 1
  fi
  printf '[failed] Could not determine the Nextflow version: %s\n' "$nextflow_bin"
  return 1
}

check_tmpdir() {
  local directory=${TMPDIR:-/tmp}
  local probe blocks gib='unknown'
  if [[ ! -d "$directory" || ! -w "$directory" ]]; then
    printf '[failed] Temporary directory does not exist or is not writable: %s\n' "$directory"
    return 1
  fi
  if ! probe=$(mktemp "$directory/scpcqtl-write-check.XXXXXX" 2>/dev/null); then
    printf '[failed] Could not create a file in temporary directory: %s\n' "$directory"
    return 1
  fi
  rm -f "$probe"
  blocks=$(df -Pk "$directory" 2>/dev/null | awk 'NR == 2 {print $4}')
  if [[ "$blocks" =~ ^[0-9]+$ ]]; then
    gib=$(( blocks / 1024 / 1024 ))
  fi
  printf '[ok] Temporary directory: %s (%s GiB available)\n' "$directory" "$gib"
}

check_runtime() {
  local runtime=$1
  case "$runtime" in
    docker)
      docker info >/dev/null 2>&1 || {
        printf '[failed] Docker is installed but its daemon is unavailable\n'
        return 1
      }
      ;;
    podman)
      podman info >/dev/null 2>&1 || {
        printf '[failed] Podman is installed but its machine/service is unavailable\n'
        return 1
      }
      ;;
    apptainer) apptainer --version >/dev/null 2>&1 ;;
    singularity) singularity --version >/dev/null 2>&1 ;;
  esac
  printf '[ok] Container runtime: %s\n' "$runtime"
}

check_runtime_deep() {
  local runtime=$1
  local image=${SCPCQTL_SMOKE_IMAGE:-docker.io/library/alpine:3.20}
  local image_ref=$image
  local scratch log result
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/scpcqtl-runtime-check.XXXXXX")
  log="$scratch/runtime.log"
  result="$scratch/result"

  case "$runtime" in
    docker|podman)
      if ! "$runtime" run --rm --platform linux/amd64 \
        --cpu-shares 1024 --memory 64m \
        -v "$scratch:/scpcqtl-probe" \
        "$image" sh -c \
        'printf "sc-pcqtl-runtime-ok\n" > /scpcqtl-probe/result' \
        >"$log" 2>&1; then
        printf '[failed] %s could not pull/run the smoke image with a writable bind mount and resource limits\n' "$runtime"
        sed -n '1,20p' "$log"
        rm -rf "$scratch"
        return 1
      fi
      ;;
    apptainer|singularity)
      [[ "$image_ref" == *://* ]] || image_ref="docker://$image_ref"
      if ! "$runtime" exec --bind "$scratch:/scpcqtl-probe" \
        "$image_ref" sh -c \
        'printf "sc-pcqtl-runtime-ok\n" > /scpcqtl-probe/result' \
        >"$log" 2>&1; then
        printf '[failed] %s could not pull/run the smoke image with a writable bind mount\n' "$runtime"
        sed -n '1,20p' "$log"
        rm -rf "$scratch"
        return 1
      fi
      ;;
  esac

  if [[ ! -f "$result" ]] || [[ "$(<"$result")" != 'sc-pcqtl-runtime-ok' ]]; then
    printf '[failed] Container smoke test did not write the expected host-mounted output\n'
    rm -rf "$scratch"
    return 1
  fi
  rm -rf "$scratch"
  if [[ "$runtime" == 'docker' || "$runtime" == 'podman' ]]; then
    printf '[ok] Container pull, amd64 execution, bind mount, and resource smoke test\n'
  else
    printf '[ok] Container pull, amd64 execution, and bind mount smoke test\n'
  fi
}

doctor() {
  local status=0 runtime='' deep=false
  while (( $# )); do
    case "$1" in
      --deep) deep=true ;;
      *) die "unknown doctor option: $1" ;;
    esac
    shift
  done
  printf 'Host: %s %s\n' "$(uname -s)" "$(uname -m)"
  check_java || status=1
  check_nextflow || status=1
  check_tmpdir || status=1
  if runtime=$(select_runtime 2>/dev/null); then
    check_runtime "$runtime" || status=1
    if [[ "$runtime" == 'podman' ]] && \
      [[ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null || true)" == 'true' ]]; then
      printf '[info] Rootless Podman requires configured subordinate IDs and cgroup delegation\n'
    fi
    if [[ "$deep" == true ]]; then
      check_runtime_deep "$runtime" || status=1
    else
      printf '[info] Run sc-pcqtl doctor --deep to test image pull, execution, and bind mounts\n'
    fi
  else
    printf '[missing] No usable Docker/Podman or Linux Apptainer/Singularity runtime\n'
    status=1
  fi
  if [[ "$(uname -m)" == 'arm64' || "$(uname -m)" == 'aarch64' ]]; then
    printf '[info] ARM64 hosts use the pinned linux/amd64 containers through emulation\n'
  fi
  return "$status"
}

print_run() {
  local runtime=$1 profiles=$2
  printf 'Runtime: %s\n' "$runtime"
  if [[ -d "$pipeline" ]]; then
    printf 'Pipeline: %s (local checkout)\n' "$pipeline"
  else
    printf 'Pipeline: %s (revision %s)\n' "$pipeline" "$revision"
  fi
  printf 'Profiles: %s\n' "$profiles"
}

run_pipeline() {
  local mode=$1
  shift
  local runtime profiles
  local -a command_args
  runtime=$(select_runtime)
  profiles=$runtime
  [[ "$mode" == 'example' ]] && profiles="${runtime},example"
  if [[ -n "${SCPCQTL_EXTRA_PROFILES:-}" ]]; then
    [[ "$SCPCQTL_EXTRA_PROFILES" =~ ^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$ ]] || \
      die 'SCPCQTL_EXTRA_PROFILES must be a comma-separated profile list'
    profiles="${profiles},${SCPCQTL_EXTRA_PROFILES}"
  fi

  print_run "$runtime" "$profiles"

  command_args=(run "$pipeline")
  if [[ ! -d "$pipeline" && -n "$revision" ]]; then
    command_args+=(-r "$revision")
  fi
  command_args+=(-profile "$profiles")
  exec "$nextflow_bin" "${command_args[@]}" "$@"
}

command_name=${1:-help}
[[ $# -gt 0 ]] && shift
case "$command_name" in
  doctor) doctor "$@" ;;
  example) run_pipeline example "$@" ;;
  run) run_pipeline run "$@" ;;
  nextflow) exec "$nextflow_bin" "$@" ;;
  version|--version|-v) printf 'sc-pcqtl %s\n' "$launcher_version" ;;
  help|--help|-h) usage ;;
  *) usage >&2; die "unknown command: $command_name" ;;
esac
